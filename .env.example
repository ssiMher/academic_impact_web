# Copy this file to `.env` or `.env.local` and fill in real values.
# This project does not depend on the OpenClaw runtime or ~/.openclaw/.env.

ACADEMIC_IMPACT_ANALYSIS_MODE=single_model
ACADEMIC_IMPACT_LLM_URL=http://127.0.0.1:8002/v1/chat/completions
ACADEMIC_IMPACT_LLM_MODEL=Qwen3.5-27B-Q4_K_M.gguf
ACADEMIC_IMPACT_LLM_API_KEY=
ACADEMIC_IMPACT_LLM_DISABLE_THINKING=true
ACADEMIC_IMPACT_FULLTEXT_DIRECT_MAX_CHARS=90000

# Discover keeps Semantic Scholar as the primary citation source. When it succeeds,
# these options allow bounded OpenAlex lookups to enrich author institutions.
ACADEMIC_IMPACT_OPENALEX_ENRICH=1
ACADEMIC_IMPACT_OPENALEX_ENRICH_LIMIT=20

# Temporary rollback mode only:
# ACADEMIC_IMPACT_ANALYSIS_MODE=legacy_two_stage
# DEEPSEEK_API_KEY=your_deepseek_api_key
# ACADEMIC_IMPACT_LOCAL_LLM_URL=http://127.0.0.1:8002/v1/chat/completions
# ACADEMIC_IMPACT_LOCAL_MODEL=Qwen3.5-27B-Q4_K_M.gguf
